{
  "name": "openzh-web",
  "private": true,
  "type": "module",
  "description": "Browser wrapper and browser tests for the WebAssembly engine build.",
  "scripts": {
    "serve": "npm run build && node scripts/serve.mjs --port 4173 --mount /smoke=smoke --mount /app=app --mount /engine=../build/webgpu/GeneralsMD --mount /dist=dist --mount /harness=tests/harness --mount /=app",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "replay": "node scripts/run-replay.mjs",
    "build": "esbuild src/test-api.ts src/bridge-worker.ts src/engine.ts src/main.ts --bundle --format=esm --target=es2022 --outdir=dist --log-level=warning",
    "package": "npm run build && node scripts/package.mjs",
    "publish:pages": "node scripts/publish-pages.mjs",
    "bench": "playwright test --config playwright.bench.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "qrcode-generator": "1.4.4"
  }
}
